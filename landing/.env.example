# Landing (Next.js) environment template.
# Copy to landing/.env (or .env.local) and fill in values.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time. Do NOT
# put server-side secrets behind a NEXT_PUBLIC_ name.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LiveKit WebSocket URL — exposed to the browser by the embed SDK.
NEXT_PUBLIC_LIVEKIT_WS_URL=

# Optional: App Store / TestFlight / download URL shown in CTAs across the
# marketing pages and miniapp player. Empty hides the CTA.
NEXT_PUBLIC_APP_DOWNLOAD_URL=

# Server-only: HMAC signing secret for miniapp webhooks. Must match
# MINIAPP_WEBHOOK_SECRET in the backend.
MINIAPP_WEBHOOK_SECRET=
