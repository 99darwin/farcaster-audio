{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile",
    "watchPatterns": [
      "/backend/**",
      "/Dockerfile",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "alembic upgrade head"
    ]
  }
}
