# Backend (FastAPI) environment template.
# Copy to backend/.env and fill in values. Never commit a populated .env file.
# Sensitive values are flagged below — operator-provided per deploy.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Database & cache ---
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/farcaster_audio
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) ---
# REQUIRED, SENSITIVE — replace before any non-local deploy.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72
JWT_REFRESH_EXPIRY_DAYS=30

# --- Sign-In With Farcaster (SIWF / EIP-4361) ---
# REQUIRED. Comma-separated allowlist of domains for the SIWE `domain` field
# (e.g. "yourapp.com,www.yourapp.com"). Empty = SIWF login fails closed.
SIWF_DOMAIN=

# --- Farcaster Quick Auth (miniapp) ---
QUICKAUTH_ALLOWED_AUDIENCES=
QUICKAUTH_ISSUER=https://auth.farcaster.xyz
QUICKAUTH_JWKS_URL=https://auth.farcaster.xyz/.well-known/jwks.json

# --- Neynar (Farcaster API + webhooks) ---
# REQUIRED, SENSITIVE — get keys at https://dev.neynar.com/
NEYNAR_API_KEY=
NEYNAR_CLIENT_ID=
NEYNAR_WEBHOOK_ID_CAST=
NEYNAR_WEBHOOK_ID_REACTION=
NEYNAR_WEBHOOK_ID_FOLLOW=
NEYNAR_WEBHOOK_SECRET_CAST=
NEYNAR_WEBHOOK_SECRET_REACTION=
NEYNAR_WEBHOOK_SECRET_FOLLOW=

# --- LiveKit (audio SFU) ---
# REQUIRED, SENSITIVE — get a cloud account at https://livekit.io or self-host.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://your-livekit-host.livekit.cloud

# --- Media / third-party services ---
GIPHY_API_KEY=
DEEPGRAM_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=

# --- Storage (S3-compatible) ---
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Leave blank for AWS S3 proper; set for R2, B2, MinIO, etc.
AWS_ENDPOINT_URL=

# --- Webhooks & admin ---
MINIAPP_WEBHOOK_SECRET=
ADMIN_SECRET=

# --- Juke Developer API (per-app key management) ---
JUKE_API_KEY_PEPPER=
JUKE_API_KEY_ENCRYPTION_KEY=
JUKE_API_AUDIT_SECRET=

# --- Farcaster app signer ---
JUKEAUDIO_SIGNER_UUID=
FARCASTER_APP_MNEMONIC=
FARCASTER_APP_FID=0

# --- Feature flags ---
RECORDING_ENABLED=false
SPAM_FILTER_ENABLED=true
DEMO_LOGIN_ENABLED=false
DEMO_CAST_HASH=

# --- x402 agent payments (Coinbase x402 + Base USDC) ---
X402_ENABLED=false
X402_PAYMENT_ADDRESS=
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_NETWORK=eip155:8453
X402_USDC_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AGENT_JOIN_TOLL=1000
AGENT_FID_START=9000000000
