# Juke backend configuration — copy to backend/.env and fill in.
# Keys only; never commit real values. Defaults live in app/config.py.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
SIWF_DOMAIN=
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/juke
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
ADMIN_SECRET=

# --- Edge / network limits (see docs/backend-network-limits.md) ---
# Comma-separated CIDRs of proxies allowed to set X-Forwarded-For. "none" disables header trust.
TRUSTED_PROXY_IPS=
REDIS_MAX_CONNECTIONS=500
REDIS_PUBSUB_MAX_CONNECTIONS=2000
REDIS_POOL_TIMEOUT_SECONDS=5.0
MESSAGES_WS_MAX_PER_FID=5
ROOM_EVENTS_WS_MAX_PER_IP=100

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72
JWT_REFRESH_EXPIRY_DAYS=30
# Comma-separated audiences accepted for Protocol Auth (hqa1) tokens. Empty disables it.
QUICKAUTH_ALLOWED_AUDIENCES=
DEMO_LOGIN_ENABLED=false
DEMO_CAST_HASH=

# --- Farcaster / Hypersnap ---
HYPERSNAP_HTTP_URL=https://haatz.quilibrium.com
HYPERSNAP_WEBHOOK_SECRET_CAST=
HYPERSNAP_WEBHOOK_SECRET_MENTION=
HYPERSNAP_WEBHOOK_SECRET_REACTION=
HYPERSNAP_WEBHOOK_SECRET_FOLLOW=
HYPERSNAP_WEBHOOK_SECRET_ROOM_REPLY=
MINIAPP_WEBHOOK_SECRET=
BRAND_FID=
SPAM_FILTER_ENABLED=true
# Optional: mini app search provider ("neynar" needs NEYNAR_API_KEY).
MINIAPP_SEARCH_PROVIDER=neynar
NEYNAR_API_KEY=

# --- Signers and KeyGateway relayer (Optimism) ---
OPTIMISM_RPC_URL=
KEY_RELAYER_PRIVATE_KEY=
KEY_RELAYER_MIN_BALANCE_WEI=5000000000000000
# AES key for stored posting keys and Direct Cast tokens. For rotation use
# SIGNER_ENCRYPTION_KEYS="kid1:key1,kid2:key2" (first entry encrypts).
SIGNER_ENCRYPTION_KEY=
SIGNER_ENCRYPTION_KEYS=
JUKEAUDIO_SIGNER_PRIVATE_KEY_ENCRYPTED=
JUKE_BOT_SIGNER_ENCRYPTION_KEY=

# --- Juke's own Farcaster account ---
JUKE_FARCASTER_CUSTODY_PRIVATE_KEY=
JUKE_FARCASTER_FID=0
JUKE_FARCASTER_BEARER_REFRESH_THRESHOLD_HOURS=24

# --- Developer API ---
JUKE_API_KEY_PEPPER=
JUKE_API_KEY_ENCRYPTION_KEY=
JUKE_API_AUDIT_SECRET=
# Ops-managed custody bots: "app_uuid:JUKE_DEV_BOT_CUSTODY_<NAME>,..."; the key
# itself lives in the named env var.
DEVELOPER_CUSTODY_KEY_REFS=
MAX_AGENTS_PER_ROOM=5
AGENT_FID_START=9000000000

# --- x402 agent join toll (optional) ---
X402_ENABLED=false
X402_PAYMENT_ADDRESS=
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_NETWORK=eip155:8453
X402_USDC_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AGENT_JOIN_TOLL=1000

# --- Direct Casts ---
MESSAGING_ENABLED=false
MESSAGING_BACKEND=farcaster
MESSAGING_RELAY_ENABLED=false

# --- Audio (LiveKit) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://your-livekit-host.livekit.cloud

# --- Recording ---
RECORDING_ENABLED=false
RECORDING_DRAIN_TIMEOUT_SECONDS=35.0
JUKE_RECORDING_AGENT_FIDS=[]
JUKE_RECORDING_AGENT_CUSTODY_KEYS_JSON=
JUKE_RECORDING_AGENT_NODE_BIN=node
DEEPGRAM_API_KEY=

# --- Storage (S3-compatible) ---
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# --- Media / misc ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GIPHY_API_KEY=
LEADERBOARD_AGGREGATION_ENABLED=false
