{
  "expo": {
    "name": "Juke",
    "slug": "juke",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "juke",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0f23"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.juke.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Required to speak in audio spaces",
        "NSCameraUsageDescription": "Not used in this app",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "juke"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "juke"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "xyz.juke.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "owner": "your-expo-owner"
  }
}
