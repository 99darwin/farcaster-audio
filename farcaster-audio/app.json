{
  "expo": {
    "name": "Juke",
    "slug": "juke",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "juke",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0f23"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.juke.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Required to speak in audio spaces",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "juke"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "xyz.juke.app"
    }
  }
}
