{
  "expo": {
    "name": "Juke",
    "slug": "juke",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "juke",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0f23"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.juke.app",
      "associatedDomains": ["applinks:juke.audio"],
      "infoPlist": {
        "UIBackgroundModes": ["audio", "remote-notification"],
        "NSMicrophoneUsageDescription": "Required to speak in audio spaces and record voice notes",
        "NSCalendarsUsageDescription": "Add scheduled Juke spaces to your calendar",
        "NSCalendarsFullAccessUsageDescription": "Add scheduled Juke spaces to your calendar",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add scheduled Juke spaces to your calendar",
        "NSRemindersUsageDescription": "Allow Juke to check reminders permissions required by the calendar module",
        "NSRemindersFullAccessUsageDescription": "Allow Juke to check reminders permissions required by the calendar module",
        "NSCameraUsageDescription": "Not used in this app",
        "NSPhotoLibraryUsageDescription": "Attach photos to your casts",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["juke"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "runtimeVersion": "0.1.0",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native/expo",
      "expo-image-picker",
      "expo-calendar",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#855DCD"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PressStart2P-Regular.ttf",
            "./assets/fonts/DSEG7Classic-Bold.ttf"
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "xyz.juke.app"
    },
    "extra": {
      "router": {}
    }
  }
}
