# Mobile (Expo) environment template.
# Copy to farcaster-audio/.env and fill in values.
#
# IMPORTANT: every EXPO_PUBLIC_* var is bundled into the client JS and shipped
# to every user's device. NEVER put server-side secrets here.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# LiveKit WebSocket URL — operator-provided. Leave blank to disable audio.
EXPO_PUBLIC_LIVEKIT_WS_URL=

# Optional: error reporting
EXPO_PUBLIC_SENTRY_DSN=

# Neynar — CLIENT_ID is safe to bundle. The API_KEY here is the Neynar-issued
# public client key for SIWN; not the server admin key.
EXPO_PUBLIC_NEYNAR_CLIENT_ID=
EXPO_PUBLIC_NEYNAR_API_KEY=
