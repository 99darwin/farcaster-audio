# Mobile (Expo) environment template.
# Copy to farcaster-audio/.env and fill in values.
#
# IMPORTANT: every EXPO_PUBLIC_* var is bundled into the client JS and shipped
# to every user's device. Treat *every* value here as public-by-design. Use
# client-scoped, rate-limited keys (or proxy through your backend) — never put
# a server admin key or signing secret behind a EXPO_PUBLIC_ name.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# LiveKit WebSocket URL — operator-provided. Leave blank to disable audio.
EXPO_PUBLIC_LIVEKIT_WS_URL=

# Optional: error reporting
EXPO_PUBLIC_SENTRY_DSN=

# Required for expo-notifications. Get from `eas init` (or expo.dev project
# settings) after binding your own Expo project. Without it, push token
# registration is a no-op.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Neynar — every value below is bundled into the client. Use a Neynar API key
# that is scoped to client-side reads / SIWN flows ONLY, with strict rate
# limits, or route Neynar calls through your backend instead.
EXPO_PUBLIC_NEYNAR_CLIENT_ID=
EXPO_PUBLIC_NEYNAR_API_KEY=
